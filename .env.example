# Copy to .env and point at your own server.
#
# Only prefills the sign-in form — anyone can enter a different address there,
# and the choice is remembered per browser.
VITE_JELLYFIN_SERVER=http://jellyfin.example.com:8096

# Optional. Seeds the Jellyseerr address on first run; after that it lives in
# apollo.runtime.json and is editable from Dashboard -> Connections.
VITE_JELLYSEERR_TARGET=
