# Plain LXC / VM install, no Docker.
#
#   adduser --system --group apollo
#   git clone <repo> /opt/apollo && cd /opt/apollo
#   npm ci && npm run build
#   chown -R apollo:apollo /opt/apollo
#   cp apollo.service /etc/systemd/system/
#   systemctl enable --now apollo
#
[Unit]
Description=Apollo — a modern web client for Jellyfin
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=apollo
Group=apollo
WorkingDirectory=/opt/apollo
Environment=NODE_ENV=production
Environment=PORT=4173
ExecStart=/usr/bin/node /opt/apollo/server/index.mjs
Restart=on-failure
RestartSec=5

# The service only needs to read its own directory and write apollo.runtime.json.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/apollo

[Install]
WantedBy=multi-user.target
